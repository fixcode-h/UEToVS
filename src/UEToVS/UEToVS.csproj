<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!--
    VSIX for Visual Studio 2022 (17.x) and 2026 (18.x).
    On Windows: build with Visual Studio or "msbuild /restore" to produce bin\<Config>\UEToVS.vsix.
    On other OSes the C# code compiles (CI check) but VSCT compilation and VSIX packaging are skipped.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>UEToVS</RootNamespace>
    <AssemblyName>UEToVS</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseCodeBase>true</UseCodeBase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
    <NoWarn>$(NoWarn);VSTHRD010;VSTHRD100;VSTHRD110;VSSDK006</NoWarn>
    <IndexerConfiguration Condition="'$(IndexerConfiguration)' == ''">Release</IndexerConfiguration>
    <RipgrepVersion>14.1.1</RipgrepVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.0.5232" Condition="'$(IsWindows)' == 'true'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UEToVS.Core\UEToVS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="UEToVSPackage.vsct" Condition="'$(IsWindows)' == 'true'">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="UEToVSPackage.vsct" Condition="'$(IsWindows)' != 'true'" />
    <Content Include="Resources\Icon.png" IncludeInVSIX="true" />
    <Content Include="LICENSE.txt" IncludeInVSIX="true" />
    <Content Include="..\..\ue\UEToVSLink\**\*" Exclude="..\..\ue\UEToVSLink\Binaries\**;..\..\ue\UEToVSLink\Intermediate\**">
      <Link>EditorPlugin\UEToVSLink\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>EditorPlugin\UEToVSLink\%(RecursiveDir)</VSIXSubPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Publish the indexer next to the extension: <ext>\Indexer\UEToVS.Indexer.exe (+ rg.exe). -->
  <Target Name="PublishIndexer" BeforeTargets="GetVsixSourceItems;PrepareForBuild" Condition="'$(IsWindows)' == 'true' And '$(SkipIndexerPublish)' != 'true'">
    <MSBuild Projects="..\UEToVS.Indexer\UEToVS.Indexer.csproj" Targets="Restore" Properties="RuntimeIdentifier=win-x64" />
    <MSBuild Projects="..\UEToVS.Indexer\UEToVS.Indexer.csproj" Targets="Publish"
             Properties="Configuration=$(IndexerConfiguration);RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(MSBuildProjectDirectory)\obj\IndexerPublish\" />
    <DownloadFile Condition="!Exists('$(MSBuildProjectDirectory)\obj\rg\rg.zip')" ContinueOnError="true"
                  SourceUrl="https://github.com/BurntSushi/ripgrep/releases/download/$(RipgrepVersion)/ripgrep-$(RipgrepVersion)-x86_64-pc-windows-msvc.zip"
                  DestinationFolder="$(MSBuildProjectDirectory)\obj\rg" DestinationFileName="rg.zip" />
    <Unzip Condition="Exists('$(MSBuildProjectDirectory)\obj\rg\rg.zip')" ContinueOnError="true"
           SourceFiles="$(MSBuildProjectDirectory)\obj\rg\rg.zip" DestinationFolder="$(MSBuildProjectDirectory)\obj\rg" />
    <ItemGroup>
      <IndexerFiles Include="$(MSBuildProjectDirectory)\obj\IndexerPublish\**\*" />
      <IndexerFiles Include="$(MSBuildProjectDirectory)\obj\rg\ripgrep-$(RipgrepVersion)-x86_64-pc-windows-msvc\rg.exe" Condition="Exists('$(MSBuildProjectDirectory)\obj\rg\ripgrep-$(RipgrepVersion)-x86_64-pc-windows-msvc\rg.exe')" />
      <Content Include="@(IndexerFiles)">
        <Link>Indexer\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>Indexer\%(RecursiveDir)</VSIXSubPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- SDK-style projects do not import the VSSDK targets on their own: VSCT compilation, pkgdef and the .vsix come from here. -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(IsWindows)' == 'true' And Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
