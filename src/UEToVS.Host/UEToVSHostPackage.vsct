<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!--
    Command ids must match Shell/PackageIds.cs (CommandIds). Every command is also registered as an IAction
    (Actions/HostActions.cs) so Find Action / Alt+Enter list it; the menu handler only dispatches to the action.
    Texts: the English default is here; the host sets the localized text (Chinese unless VS is English) at runtime in
    BeforeQueryStatus, which is why every button has the TextChanges flag (Shell/CommandRouter.cs, Logic/Localization/Strings.cs).
    The menu lives under Extensions > UEToVS and is always visible (restore IntelliSense must stay reachable
    even for non-UE solutions); availability is decided in BeforeQueryStatus.
  -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidUEToVSHostPackage">
    <Menus>
      <Menu guid="guidUEToVSHostCmdSet" id="menuUEToVS" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpTopLevel" />
        <Strings>
          <ButtonText>UEToVS</ButtonText>
        </Strings>
      </Menu>
      <!-- Editor right-click > UEToVS (C++ code windows; only while an Unreal solution is open, see VisibilityConstraints). -->
      <Menu guid="guidUEToVSHostCmdSet" id="menuUEToVSContext" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpCodeWinUEToVS" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>UEToVS</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidUEToVSHostCmdSet" id="grpTopLevel" priority="0x0100">
        <Parent guid="guidVsExtensionsMenu" id="IDM_VS_MENU_EXTENSIONS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSearch" priority="0x0050">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpNavigation" priority="0x0060">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpCodeWinUEToVS" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpContextNavigation" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVSContext" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpEngine" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpIntelliSense" priority="0x0200">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpDiagnostics" priority="0x0300">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSettings" priority="0x0400">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidUEToVSHostCmdSet" id="cmdFindAction" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpSearch" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Find Action...</ButtonText>
          <CanonicalName>UEToVS.FindAction</CanonicalName>
          <LocCanonicalName>UEToVS.FindAction</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidUEToVSHostCmdSet" id="cmdRestartEngine" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpEngine" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Restart Engine</ButtonText>
          <CanonicalName>UEToVS.RestartEngine</CanonicalName>
          <LocCanonicalName>UEToVS.RestartEngine</LocCanonicalName>
        </Strings>
      </Button>

      <!-- One toggle item: text and action switch between take over / restore in BeforeQueryStatus (CommandRouter). -->
      <Button guid="guidUEToVSHostCmdSet" id="cmdToggleIntelliSense" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpIntelliSense" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Take Over C++ IntelliSense</ButtonText>
          <CanonicalName>UEToVS.ToggleIntelliSense</CanonicalName>
          <LocCanonicalName>UEToVS.ToggleIntelliSense</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidUEToVSHostCmdSet" id="cmdOpenLogFolder" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpDiagnostics" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Open Log Folder</ButtonText>
          <CanonicalName>UEToVS.OpenLogFolder</CanonicalName>
          <LocCanonicalName>UEToVS.OpenLogFolder</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdOpenCurrentLog" priority="0x0101" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpDiagnostics" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Open Current Log</ButtonText>
          <CanonicalName>UEToVS.OpenCurrentLog</CanonicalName>
          <LocCanonicalName>UEToVS.OpenCurrentLog</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdCreateDiagnostics" priority="0x0102" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpDiagnostics" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Create Diagnostics Package</ButtonText>
          <CanonicalName>UEToVS.CreateDiagnosticsPackage</CanonicalName>
          <LocCanonicalName>UEToVS.CreateDiagnosticsPackage</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdShowPerformancePanel" priority="0x0103" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpDiagnostics" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Performance Panel</ButtonText>
          <CanonicalName>UEToVS.PerformancePanel</CanonicalName>
          <LocCanonicalName>UEToVS.PerformancePanel</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdShowComponentGallery" priority="0x0104" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpDiagnostics" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Component Gallery</ButtonText>
          <CanonicalName>UEToVS.ShowComponentGallery</CanonicalName>
          <LocCanonicalName>UEToVS.ShowComponentGallery</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidUEToVSHostCmdSet" id="cmdSettings" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpSettings" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Settings...</ButtonText>
          <CanonicalName>UEToVS.Settings</CanonicalName>
          <LocCanonicalName>UEToVS.Settings</LocCanonicalName>
        </Strings>
      </Button>

      <!-- M2 navigation (ids 0x0200-0x02FF; Navigation/NavigationActions.cs). Also placed in the editor context submenu. -->
      <Button guid="guidUEToVSHostCmdSet" id="cmdGoToDefinition" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Go to Definition / Declaration</ButtonText>
          <CanonicalName>UEToVS.GoToDefinition</CanonicalName>
          <LocCanonicalName>UEToVS.GoToDefinition</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdGoToImplementation" priority="0x0101" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Go to Implementation</ButtonText>
          <CanonicalName>UEToVS.GoToImplementation</CanonicalName>
          <LocCanonicalName>UEToVS.GoToImplementation</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdFindReferences" priority="0x0102" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Find References</ButtonText>
          <CanonicalName>UEToVS.FindReferences</CanonicalName>
          <LocCanonicalName>UEToVS.FindReferences</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdTypeHierarchy" priority="0x0103" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Type Hierarchy</ButtonText>
          <CanonicalName>UEToVS.TypeHierarchy</CanonicalName>
          <LocCanonicalName>UEToVS.TypeHierarchy</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdListMembersInFile" priority="0x0104" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>List Members in File</ButtonText>
          <CanonicalName>UEToVS.ListMembersInFile</CanonicalName>
          <LocCanonicalName>UEToVS.ListMembersInFile</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdListTypeMembers" priority="0x0105" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpNavigation" />
        <CommandFlag>TextChanges</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Type Members (with Inherited)</ButtonText>
          <CanonicalName>UEToVS.ListTypeMembers</CanonicalName>
          <LocCanonicalName>UEToVS.ListTypeMembers</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdGoToDefinition" priority="0x0100">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdGoToImplementation" priority="0x0101">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdFindReferences" priority="0x0102">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdTypeHierarchy" priority="0x0103">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdListMembersInFile" priority="0x0104">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
    <CommandPlacement guid="guidUEToVSHostCmdSet" id="cmdListTypeMembers" priority="0x0105">
      <Parent guid="guidUEToVSHostCmdSet" id="grpContextNavigation" />
    </CommandPlacement>
  </CommandPlacements>

  <VisibilityConstraints>
    <VisibilityItem guid="guidUEToVSHostCmdSet" id="menuUEToVSContext" context="guidUnrealSolutionContext" />
  </VisibilityConstraints>

  <!-- Default keys (text editor scope). The keymap presets may rebind them. -->
  <KeyBindings>
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToDefinition" editor="guidTextEditorFactory" key1="G" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToImplementation" editor="guidTextEditorFactory" key1="G" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFindReferences" editor="guidTextEditorFactory" key1="F" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdTypeHierarchy" editor="guidTextEditorFactory" key1="H" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdListMembersInFile" editor="guidTextEditorFactory" key1="M" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdListTypeMembers" editor="guidTextEditorFactory" key1="M" mod1="Alt Shift" />
  </KeyBindings>

  <Symbols>
    <!-- Extensions menu, declared locally (not every VSSDK version exposes it in vsshlids.h). -->
    <GuidSymbol name="guidVsExtensionsMenu" value="{d309f791-903f-11d0-9efc-00a0c911004f}">
      <IDSymbol name="IDM_VS_MENU_EXTENSIONS" value="0x0091" />
    </GuidSymbol>
    <!-- Text editor scope for KeyBindings (GUID_TextEditorFactory). -->
    <GuidSymbol name="guidTextEditorFactory" value="{8B382828-6202-11d1-8870-0000F87579D2}" />
    <!-- PackageGuids.UnrealSolutionContextString: active while an Unreal Engine solution is open. -->
    <GuidSymbol name="guidUnrealSolutionContext" value="{67abac9a-1494-4743-8a5c-8ea3e3142c4c}" />
    <GuidSymbol name="guidUEToVSHostPackage" value="{b77c0841-5e27-4061-b4ec-364fc5d594a6}" />
    <GuidSymbol name="guidUEToVSHostCmdSet" value="{aacea68e-71c0-4b88-baf0-43e34d9fa8a7}">
      <IDSymbol name="menuUEToVS" value="0x1000" />
      <IDSymbol name="grpTopLevel" value="0x1010" />
      <IDSymbol name="grpEngine" value="0x1011" />
      <IDSymbol name="grpIntelliSense" value="0x1012" />
      <IDSymbol name="grpDiagnostics" value="0x1013" />
      <IDSymbol name="grpSettings" value="0x1014" />
      <IDSymbol name="grpSearch" value="0x1015" />
      <IDSymbol name="cmdOpenLogFolder" value="0x0100" />
      <IDSymbol name="cmdOpenCurrentLog" value="0x0101" />
      <IDSymbol name="cmdCreateDiagnostics" value="0x0102" />
      <IDSymbol name="cmdShowPerformancePanel" value="0x0104" />
      <IDSymbol name="cmdRestartEngine" value="0x0110" />
      <IDSymbol name="cmdToggleIntelliSense" value="0x0120" />
      <IDSymbol name="cmdShowComponentGallery" value="0x0130" />
      <IDSymbol name="cmdSettings" value="0x0140" />
      <IDSymbol name="cmdFindAction" value="0x0150" />
      <IDSymbol name="menuUEToVSContext" value="0x1001" />
      <IDSymbol name="grpNavigation" value="0x1020" />
      <IDSymbol name="grpCodeWinUEToVS" value="0x1021" />
      <IDSymbol name="grpContextNavigation" value="0x1022" />
      <IDSymbol name="cmdGoToDefinition" value="0x0200" />
      <IDSymbol name="cmdGoToImplementation" value="0x0201" />
      <IDSymbol name="cmdFindReferences" value="0x0202" />
      <IDSymbol name="cmdTypeHierarchy" value="0x0203" />
      <IDSymbol name="cmdListMembersInFile" value="0x0204" />
      <IDSymbol name="cmdListTypeMembers" value="0x0205" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
