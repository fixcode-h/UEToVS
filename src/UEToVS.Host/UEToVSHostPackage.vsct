  <!-- Default keys (text editor scope). The keymap presets may rebind them. -->
  <KeyBindings>
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToDefinition" editor="guidTextEditorFactory" key1="G" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToImplementation" editor="guidTextEditorFactory" key1="G" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFindReferences" editor="guidTextEditorFactory" key1="F" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdTypeHierarchy" editor="guidTextEditorFactory" key1="H" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdListMembersInFile" editor="guidTextEditorFactory" key1="M" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdListTypeMembers" editor="guidTextEditorFactory" key1="M" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdNavigateBack" editor="guidVSStd97" key1="VK_LEFT" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdNavigateForward" editor="guidVSStd97" key1="VK_RIGHT" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdToggleHeaderSource" editor="guidVSStd97" key1="O" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdLiveCoding" editor="guidVSStd97" key1="VK_F11" mod1="Control Alt" />
    <!-- v0.3.0 Visual Assist style additions (CommandCatalog VaKeys). Search Everywhere = double Shift (M1 InputMonitor). -->
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToFile" editor="guidVSStd97" key1="O" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToSymbol" editor="guidVSStd97" key1="S" mod1="Alt Shift" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFindAction" editor="guidVSStd97" key1="A" mod1="Control Alt Shift" />
    <!-- v0.3.3: every command has a default (tools use the Ctrl+Shift+Alt+U chord). -->
