<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!--
    Command ids must match Shell/PackageIds.cs (CommandIds) and Logic/Commands/CommandCatalog.cs (a unit test checks
    ids and key bindings). Every command dispatches to an IAction (Actions/HostActions.cs) so Find Action lists it.
    Texts: the English default is here; the host sets the localized text at runtime in BeforeQueryStatus, which is
    why every button has the TextChanges flag (Shell/CommandRouter.cs, Logic/Localization/Strings.cs).

    Layout (v0.3.0):
    - Extensions > UEToVS keeps only the everyday items: Find Action, Search Everywhere, the navigation group
      (reserved for M2; items appear once the navigation module registers their actions), Performance Panel, Settings.
    - Restart engine, IntelliSense take over/restore, logs, diagnostics package and the component gallery live in the
      settings window (and Find Action); they stay declared here without a parent so they keep their key bindings.
    - The "UEToVS" toolbar: brand-icon button (opens the settings window) + Search Everywhere, back/forward, go to
      definition, find references, performance panel. Visibility per button comes from the settings window.
    Id ranges: 0x01xx existing, 0x02xx M2 navigation, 0x03xx M1 features, 0x04xx settings / windows / toolbar.
  -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />
  <Include href="KnownImageIds.vsct" />

  <Commands package="guidUEToVSHostPackage">
    <Menus>
      <Menu guid="guidUEToVSHostCmdSet" id="menuUEToVS" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpTopLevel" />
        <Strings>
          <ButtonText>UEToVS</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidUEToVSHostCmdSet" id="tbUEToVS" priority="0x0100" type="Toolbar">
        <CommandFlag>DefaultDocked</CommandFlag>
        <Strings>
          <ButtonText>UEToVS</ButtonText>
          <CommandName>UEToVS</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidUEToVSHostCmdSet" id="grpTopLevel" priority="0x0100">
        <Parent guid="guidVsExtensionsMenu" id="IDM_VS_MENU_EXTENSIONS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSearch" priority="0x0050">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpNavigation" priority="0x0080">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpTools" priority="0x0300">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSettings" priority="0x0400">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpToolbarMain" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="tbUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpToolbarNav" priority="0x0200">
        <Parent guid="guidUEToVSHostCmdSet" id="tbUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpToolbarTools" priority="0x0300">
        <Parent guid="guidUEToVSHostCmdSet" id="tbUEToVS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidUEToVSHostCmdSet" id="cmdFindAction" priority="0x0050" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpSearch" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
          <ButtonText>Find Action...</ButtonText>
          <CanonicalName>UEToVS.FindAction</CanonicalName>
          <LocCanonicalName>UEToVS.FindAction</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidUEToVSHostCmdSet" id="cmdSearchEverywhere" priority="0x0000" type="Button">
