<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!--
    Command ids must match Shell/PackageIds.cs (CommandIds). Every command is also registered as an IAction
    (Actions/HostActions.cs) so Find Action / Alt+Enter list it; the menu handler only dispatches to the action.
    Texts: the English default is here; the host sets the localized text (Chinese unless VS is English) at runtime in
    BeforeQueryStatus, which is why every button has the TextChanges flag (Shell/CommandRouter.cs, Logic/Localization/Strings.cs).
    The menu lives under Extensions > UEToVS and is always visible (restore IntelliSense must stay reachable
    even for non-UE solutions); availability is decided in BeforeQueryStatus.
  -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidUEToVSHostPackage">
    <Menus>
      <Menu guid="guidUEToVSHostCmdSet" id="menuUEToVS" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpTopLevel" />
        <Strings>
          <ButtonText>UEToVS</ButtonText>
        </Strings>
      </Menu>
      <!-- M1: bookmarks submenu (toggle, list, set/go to 0-9) -->
      <Menu guid="guidUEToVSHostCmdSet" id="menuM1Bookmarks" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpM1BookmarksMenu" />
        <Strings>
          <ButtonText>Bookmarks</ButtonText>
        </Strings>
      </Menu>
      <!-- Editor right-click > UEToVS (C++ code windows; only while an Unreal solution is open, see VisibilityConstraints). -->
      <Menu guid="guidUEToVSHostCmdSet" id="menuUEToVSContext" priority="0x0100" type="Menu">
        <Parent guid="guidUEToVSHostCmdSet" id="grpCodeWinUEToVS" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings>
          <ButtonText>UEToVS</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidUEToVSHostCmdSet" id="grpTopLevel" priority="0x0100">
        <Parent guid="guidVsExtensionsMenu" id="IDM_VS_MENU_EXTENSIONS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSearch" priority="0x0050">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpNavigation" priority="0x0060">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpCodeWinUEToVS" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpContextNavigation" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVSContext" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpEngine" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpIntelliSense" priority="0x0200">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpDiagnostics" priority="0x0300">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpSettings" priority="0x0400">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <!-- M1 groups: navigation, related/Build.cs, bookmarks submenu, Unreal editor tools -->
      <Group guid="guidUEToVSHostCmdSet" id="grpM1Navigation" priority="0x0060">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpM1Related" priority="0x0070">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpM1BookmarksMenu" priority="0x0080">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpM1Bookmarks" priority="0x0100">
        <Parent guid="guidUEToVSHostCmdSet" id="menuM1Bookmarks" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpM1BookmarkDigits" priority="0x0200">
        <Parent guid="guidUEToVSHostCmdSet" id="menuM1Bookmarks" />
      </Group>
      <Group guid="guidUEToVSHostCmdSet" id="grpM1Unreal" priority="0x0090">
        <Parent guid="guidUEToVSHostCmdSet" id="menuUEToVS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidUEToVSHostCmdSet" id="cmdFindAction" priority="0x0100" type="Button">
        <Parent guid="guidUEToVSHostCmdSet" id="grpSearch" />
        <CommandFlag>TextChanges</CommandFlag>
        <Strings>
