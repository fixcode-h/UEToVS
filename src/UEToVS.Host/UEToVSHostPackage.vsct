  <KeyBindings>
    <!-- Visual Assist style defaults (CommandCatalog.VaKeys). Search Everywhere = double Shift (DoubleShiftMonitor). -->
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToDefinition" editor="guidVSStd97" key1="G" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdGoToImplementation" editor="guidVSStd97" key1="G" mod1="Shift Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFindReferences" editor="guidVSStd97" key1="F" mod1="Shift Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdTypeHierarchy" editor="guidVSStd97" key1="H" mod1="Control Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdNavigateBack" editor="guidVSStd97" key1="VK_LEFT" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdNavigateForward" editor="guidVSStd97" key1="VK_RIGHT" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFileMembers" editor="guidVSStd97" key1="M" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdToggleHeaderSource" editor="guidVSStd97" key1="O" mod1="Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdOpenFile" editor="guidVSStd97" key1="O" mod1="Shift Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdSearchSymbol" editor="guidVSStd97" key1="S" mod1="Shift Alt" />
    <KeyBinding guid="guidUEToVSHostCmdSet" id="cmdFindAction" editor="guidVSStd97" key1="A" mod1="Control Shift Alt" />
  </KeyBindings>

