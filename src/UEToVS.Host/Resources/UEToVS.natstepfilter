<?xml version="1.0" encoding="utf-8"?>
<!--
  UEToVS debug step filter (generated by the UEToVS extension; setting 调试 > 调试 Step Filter).
  F11 (Step Into) skips these UE helpers and lands in the user code they call. Deleted again when the setting is turned off.
  Name is a regular expression matched against the fully qualified function name.
-->
<StepFilter xmlns="http://schemas.microsoft.com/vstudio/debugger/natstepfilter/2010">
  <!-- Container element access -->
  <Function><Name>TArray&lt;.*&gt;::operator\[\]</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TArray&lt;.*&gt;::RangeCheck</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TArrayView&lt;.*&gt;::operator\[\]</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TMap&lt;.*&gt;::operator\[\]</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TMapBase&lt;.*&gt;::operator\[\]</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TSortableMapBase&lt;.*&gt;::operator\[\]</Name><Action>NoStepInto</Action></Function>

  <!-- String / name construction -->
  <Function><Name>FString::FString</Name><Action>NoStepInto</Action></Function>
  <Function><Name>FName::FName</Name><Action>NoStepInto</Action></Function>

  <!-- TObjectPtr conversions -->
  <Function><Name>TObjectPtr&lt;.*&gt;::operator .*</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TObjectPtr&lt;.*&gt;::operator-&gt;</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TObjectPtr&lt;.*&gt;::Get</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TObjectPtr&lt;.*&gt;::TObjectPtr&lt;.*&gt;</Name><Action>NoStepInto</Action></Function>
  <Function><Name>FObjectPtr::.*</Name><Action>NoStepInto</Action></Function>

  <!-- Casts and validity checks -->
  <Function><Name>Cast&lt;.*&gt;</Name><Action>NoStepInto</Action></Function>
  <Function><Name>CastChecked&lt;.*&gt;</Name><Action>NoStepInto</Action></Function>
  <Function><Name>ExactCast&lt;.*&gt;</Name><Action>NoStepInto</Action></Function>
  <Function><Name>TCastImpl&lt;.*&gt;::.*</Name><Action>NoStepInto</Action></Function>
  <Function><Name>IsValid</Name><Action>NoStepInto</Action></Function>
  <Function><Name>IsValid&lt;.*&gt;</Name><Action>NoStepInto</Action></Function>

  <!-- check / ensure / verify internals -->
  <Function><Name>FDebug::.*</Name><Action>NoStepInto</Action></Function>
  <Function><Name>UE::Assert::Private::.*</Name><Action>NoStepInto</Action></Function>
  <Function><Name>CheckVerifyFailedImpl.*</Name><Action>NoStepInto</Action></Function>
  <Function><Name>DispatchCheckVerify.*</Name><Action>NoStepInto</Action></Function>
</StepFilter>
