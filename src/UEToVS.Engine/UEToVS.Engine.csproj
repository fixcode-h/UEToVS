<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UEToVS.Engine</RootNamespace>
    <AssemblyName>UEToVS.Engine</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- §9.5: workstation concurrent GC, a hard heap limit as insurance (managed heap only; mmap'd index segments are
         not counted), ReadyToRun on publish to cut JIT time at startup. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <NoWarn>$(NoWarn);VSTHRD002;VSTHRD003;VSTHRD103;VSTHRD105;VSTHRD110;VSTHRD200;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Safety net against runaway growth, as a share of physical RAM: a fixed 1 GiB was too small for big UE projects
         (146k sources + 840k assets ran out while writing the first project segment). Override with DOTNET_GCHeapHardLimitPercent
         (hex) or DOTNET_GCHeapHardLimit. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimitPercent" Value="25" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.19.27" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UEToVS.Contracts\UEToVS.Contracts.csproj" />
    <ProjectReference Include="..\UEToVS.Core\UEToVS.Core.csproj" />
    <ProjectReference Include="..\UEToVS.Engine.Unreal\UEToVS.Engine.Unreal.csproj" />
    <ProjectReference Include="..\UEToVS.Engine.Syntax\UEToVS.Engine.Syntax.csproj" />
    <ProjectReference Include="..\UEToVS.Engine.Index\UEToVS.Engine.Index.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UEToVS.Engine.Tests" />
  </ItemGroup>
</Project>
