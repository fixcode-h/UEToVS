<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the host's pure logic. The files under src/UEToVS.Host/Logic contain no VS types and are compiled here
    as linked sources (the VSIX project itself targets net48 + VS SDK and cannot be referenced from net8.0).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>UEToVS.Host.Logic.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\UEToVS.Host\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- WPF-free view data of UEToVS.UI used by Logic/Performance/PerformanceViewMapper.cs. -->
    <Compile Include="..\..\src\UEToVS.UI\Logic\Enums.cs" Link="UI\Enums.cs" />
    <Compile Include="..\..\src\UEToVS.UI\Logic\PerformanceViewData.cs" Link="UI\PerformanceViewData.cs" />
    <!-- Declarative settings descriptors used by Logic/Settings/HostSettingsSchema.cs (settings window). -->
    <Compile Include="..\..\src\UEToVS.UI\Logic\SettingsModel.cs" Link="UI\SettingsModel.cs" />
    <Compile Include="..\..\src\UEToVS.UI\Logic\PathListModel.cs" Link="UI\PathListModel.cs" />
    <!-- Font choices used by Logic/Fonts (外观 > 字体, VS font categories). -->
    <Compile Include="..\..\src\UEToVS.UI\Logic\FontSettings.cs" Link="UI\FontSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The VSCT is checked against Logic/Commands/CommandCatalog.cs (ids, key bindings). -->
    <None Include="..\..\src\UEToVS.Host\UEToVSHostPackage.vsct" Link="UEToVSHostPackage.vsct" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\UEToVS.Host\Resources\UEToVS.natvis" Link="UEToVS.natvis" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\UEToVS.Host\source.extension.vsixmanifest" Link="source.extension.vsixmanifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same major version VS ships; the VSIX uses VS's own copy at runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\UEToVS.Contracts\UEToVS.Contracts.csproj" />
    <ProjectReference Include="..\..\src\UEToVS.Core\UEToVS.Core.csproj" />
  </ItemGroup>
</Project>
