<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the host's pure logic. The files under src/UEToVS.Host/Logic contain no VS types and are compiled here
    as linked sources (the VSIX project itself targets net48 + VS SDK and cannot be referenced from net8.0).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>UEToVS.Host.Logic.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\UEToVS.Host\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Same major version VS ships; the VSIX uses VS's own copy at runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\UEToVS.Contracts\UEToVS.Contracts.csproj" />
    <ProjectReference Include="..\..\src\UEToVS.Core\UEToVS.Core.csproj" />
  </ItemGroup>
</Project>
